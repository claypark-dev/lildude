{
  "name": "todo-manager",
  "version": "1.0.0",
  "description": "Create, list, and manage todo items with priorities and due dates",
  "author": "lil-dude-community",
  "permissions": {
    "domains": [],
    "shell": [],
    "directories": [],
    "requiresBrowser": false,
    "requiresOAuth": []
  },
  "triggers": ["todo", "task", "to-do", "add task", "task list"],
  "deterministic": true,
  "tools": [
    {
      "name": "manage_todos",
      "description": "Add, list, complete, or delete todos",
      "parameters": {
        "action": "string",
        "text": "string",
        "priority": "string"
      }
    }
  ],
  "minTier": "basic",
  "entryPoint": "index.js",
  "safetyTier": "create"
}
