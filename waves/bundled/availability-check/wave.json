{
  "name": "availability-check",
  "version": "1.0.0",
  "description": "Check owner's available time slots without revealing event details",
  "author": "lil-dude",
  "permissions": {
    "domains": ["www.googleapis.com"],
    "shell": [],
    "directories": [],
    "requiresBrowser": false,
    "requiresOAuth": ["google"]
  },
  "triggers": ["available", "availability", "free time", "open slots", "when can", "free slots"],
  "deterministic": true,
  "tools": [
    {
      "name": "check_availability",
      "description": "Check available time slots for a date range",
      "parameters": {
        "startDate": "string",
        "endDate": "string",
        "durationMinutes": "number"
      }
    }
  ],
  "minTier": "basic",
  "entryPoint": "index.js",
  "safetyTier": "observe"
}
